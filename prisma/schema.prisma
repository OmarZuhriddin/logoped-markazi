// Logopedik markaz CRM — ma'lumotlar modeli
// Mohiyat: Filial -> Mutaxassis -> Mijoz (bola) -> Mashg'ulot (seans) -> To'lov

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

/// Filial
model Branch {
  id        String   @id @default(cuid())
  name      String   @unique
  address   String?
  phone     String?
  /// Yakka ishlaydigan mutaxassisning o'z "filiali". Markazning hisobotlari,
  /// jadvali va mijozlar ro'yxati bunday filialni ko'rmaydi — ikkovi bitta
  /// bazada tursa ham bir-biriga aralashmaydi.
  isSolo    Boolean  @default(false)
  /// Yakka logoped o'z ilovasiga qo'ygan nom va logotip (menyu tepasida).
  /// Markazniki `Settings` da — yakka logoped uni o'zgartira olmaydi, chunki
  /// u markazga tegishli emas. Bo'sh bo'lsa standart "Logoped CRM" va markaz
  /// logotipi ko'rinadi.
  brandName     String?
  logoData      String?
  logoMime      String?
  logoUpdatedAt DateTime?
  /// Yakka logopedning o'z ish vaqti. Bo'sh bo'lsa markaznikiga tushadi
  /// (`getWorkHours`). Markaz filiallarida hozircha bo'sh turadi.
  workStartHour Int?
  workEndHour   Int?
  slotMinutes   Int?
  workDays      String?
  /// Tushlik, kun boshidan daqiqada (13:00 = 780). Ikkalasi ham bo'sh — tushliksiz
  lunchStartMin Int?
  lunchEndMin   Int?
  /// Google Sheets zaxirasi (yakka logopedniki — faqat o'z ma'lumoti)
  sheetsUrl      String?
  sheetsSyncedAt DateTime?
  sheetsError    String?
  /// O'zgarish bo'lgani va yozish band ekani (`sheetsChanged`) — jadval har
  /// o'zgarishdan keyin yangilanadi, bir vaqtda ikki yozuv to'qnashmasin
  sheetsDirtyAt  DateTime?
  sheetsLockAt   DateTime?
  createdAt DateTime @default(now())

  users       User[]
  specialists Specialist[]
  clients     Client[]
  sessions    Session[]
  payments    Payment[]
  clickTransactions    ClickTransaction[]
  payouts     SalaryPayout[]
  intakes     Intake[]
  sessionTypes SessionType[]
}

/// Tizim foydalanuvchisi. role: OWNER | BRANCH_ADMIN | SPECIALIST | PARENT
model User {
  id           String   @id @default(cuid())
  phone        String   @unique // login sifatida ishlatiladi
  fullName     String
  passwordHash String
  role         String
  branchId     String? // OWNER uchun bo'sh (barcha filiallar)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  /// Telegram akkaunti (Mini App orqali kirish uchun)
  telegramId       String? @unique
  telegramUsername String?

  branch        Branch?        @relation(fields: [branchId], references: [id])
  specialist    Specialist?
  children      Client[]       @relation("ParentChildren")
  linkCodes     LinkCode[]
  notifications Notification[]
}

/// Telegram akkauntini CRM foydalanuvchisiga bog'lash uchun bir martalik kod
model LinkCode {
  id        String    @id @default(cuid())
  code      String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Mutaxassis profili. specialization: ABA | LOGOPED | AFK | MASSAGE | PSYCHOLOGIST | SENSORY
model Specialist {
  id             String  @id @default(cuid())
  userId         String  @unique
  branchId       String
  specialization String
  /// Shu mutaxassisning bitta seansi qancha turadi. Bo'sh bo'lsa markazning
  /// Sozlamalardagi standart narxi olinadi. Yakka ishlaydiganga kerak: uning
  /// narxi markaznikiga bog'liq emas.
  defaultPrice   Int?
  /// Seans narxidan mutaxassisga tegadigan foiz
  salaryPercent  Int     @default(40)
  isActive       Boolean @default(true)

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch   Branch         @relation(fields: [branchId], references: [id])
  clients  Assignment[]
  sessions Session[]
  payouts  SalaryPayout[]
  intakes  Intake[]

  @@index([branchId])
}

/// Mijoz (bola). status: ACTIVE | PAUSED | ARCHIVED
model Client {
  id           String   @id @default(cuid())
  fullName     String
  birthDate    DateTime
  gender       String? // M | F
  branchId     String
  parentUserId String?
  parentName   String
  parentPhone  String
  diagnosis    String?
  note         String?
  status       String   @default("ACTIVE")
  /// DAILY | PACKAGE — mijoz har kelganida to'laydimi yoki abonement oladimi.
  /// Ko'pchilik kunlik to'laydi, shuning uchun standarti DAILY.
  billingType  String   @default("DAILY")
  createdAt    DateTime @default(now())

  branch        Branch         @relation(fields: [branchId], references: [id])
  parent        User?          @relation("ParentChildren", fields: [parentUserId], references: [id])
  specialists   Assignment[]
  packages      Package[]
  sessions      Session[]
  payments      Payment[]
  clickTransactions      ClickTransaction[]
  notifications Notification[]
  services      ClientService[]
  intake        Intake?

  @@index([branchId])
  @@index([parentUserId])
}

/// Mijoz <-> mutaxassis bog'lanishi ("har kimning o'z mijozlari")
model Assignment {
  id           String   @id @default(cuid())
  clientId     String
  specialistId String
  createdAt    DateTime @default(now())

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)

  @@unique([clientId, specialistId])
}

/// Abonement (seans paketi)
model Package {
  id              String    @id @default(cuid())
  clientId        String
  /// Eski abonementlar yo'nalishga (Logoped, Massajchi...) bog'langan edi.
  /// Yangilari xizmatga bog'lanadi — ularda bu bo'sh.
  specialization  String?
  /// Qaysi xizmat abonementi ("Massaj: 10 seans"). Shu xizmat seanslari
  /// shu abonementdan yechiladi.
  sessionTypeId   String?
  totalSessions   Int
  /// Bitta seans narxi, so'mda
  pricePerSession Int
  purchasedAt     DateTime  @default(now())
  expiresAt       DateTime?
  isActive        Boolean   @default(true)

  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessionType SessionType? @relation(fields: [sessionTypeId], references: [id], onDelete: SetNull)
  sessions    Session[]
  payments    Payment[]

  @@index([clientId])
}

/// Mashg'ulot (seans). status: PLANNED | DONE | NO_SHOW | CANCELLED_CLIENT | CANCELLED_CENTER
model Session {
  id           String   @id @default(cuid())
  clientId     String
  specialistId String
  branchId     String
  packageId    String?
  /// Seans turi (Sozlamalardagi ro'yxatdan). Bo'sh bo'lishi mumkin — turlar
  /// qo'shilishidan oldingi seanslar va tur tanlanmagan seanslar uchun.
  sessionTypeId String?
  startsAt     DateTime
  durationMin  Int      @default(45)
  status       String   @default("PLANNED")
  /// Seans narxi, so'mda (abonementdan yoki qo'lda)
  price        Int      @default(0)
  /// Seans "o'tdi/kelmadi" deb belgilangan paytdagi mutaxassis foizi.
  /// Keyinchalik foiz o'zgarsa, o'tgan seanslarning hisobi o'zgarmasligi uchun saqlanadi.
  salaryPercent Int?
  /// Xodimlar uchun ichki izoh — ota-onaga ko'rinmaydi
  note         String?
  createdAt    DateTime @default(now())

  client     Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  specialist Specialist @relation(fields: [specialistId], references: [id])
  branch     Branch     @relation(fields: [branchId], references: [id])
  package    Package?   @relation(fields: [packageId], references: [id])
  // Tur o'chirilsa seans qoladi — uning narxi seansning o'zida saqlangan
  sessionType SessionType? @relation(fields: [sessionTypeId], references: [id], onDelete: SetNull)

  @@index([startsAt])
  @@index([specialistId, startsAt])
  @@index([clientId, startsAt])
  @@index([branchId, startsAt])
}

/// To'lov. method: CASH | CARD | TRANSFER
/// Markaz sozlamalari. Bazada doim bitta qator bo'ladi (id = "main"):
/// nomi, ish vaqti, standart narx va ulush foizi.
model Settings {
  id                  String   @id @default("main")
  centerName          String   @default("Logopedik markaz")
  centerPhone         String?
  /// To'lov summasi kiritilmaganda ishlatiladigan standart seans narxi, so'mda
  defaultPrice        Int      @default(150000)
  /// Yangi qo'shiladigan mutaxassis uchun standart ulush foizi
  defaultSalaryPercent Int     @default(40)
  /// Ish kuni necha soatda boshlanadi va tugaydi (0-23)
  workStartHour       Int      @default(9)
  workEndHour         Int      @default(18)
  /// Bo'sh vaqtlar qanday oraliqda hisoblanadi, daqiqada
  slotMinutes         Int      @default(60)
  /// Ish kunlari: 1=dushanba ... 7=yakshanba, vergul bilan ("1,2,3,4,5,6")
  workDays            String   @default("1,2,3,4,5,6")
  /// Markaz logotipi (base64). Vercel'da diskka fayl yozib bo'lmaydi va u har
  /// deploy'da tozalanadi, shuning uchun rasm bazada turadi. Hajmi kichik
  /// (500 KB gacha) — bitta qator, alohida xizmat kerak emas.
  logoData            String?
  /// image/png | image/jpeg | image/webp
  logoMime            String?
  /// Rasm almashganda brauzer keshini yangilash uchun manzilga qo'shiladi
  logoUpdatedAt       DateTime?
  /// Tushlik, kun boshidan daqiqada (13:00 = 780). Bo'sh — tushliksiz.
  /// Bo'sh vaqtlar shu oraliqni chetlab o'tadi.
  lunchStartMin       Int?
  lunchEndMin         Int?
  /// Google Sheets zaxirasi: jadvalga qo'yilgan Apps Script'ning manzili.
  /// Markaz ma'lumoti (yakka logopedlarsiz) har kuni shu jadvalga yoziladi.
  sheetsUrl           String?
  sheetsSyncedAt      DateTime?
  /// Oxirgi urinish xato bo'lsa — sababi (Sozlamalarda ko'rinadi)
  sheetsError         String?
  /// O'zgarish bo'lgani va yozish band ekani (`sheetsChanged`)
  sheetsDirtyAt       DateTime?
  sheetsLockAt        DateTime?
  /// `npm run db:timezone` bir marta ishlaganini belgilaydi. Skript vaqtlarni
  /// siljitadi, ikki marta ishlasa jadval ikki barobar siljib ketardi.
  timezoneShiftedAt   DateTime?
  /// Yakka mutaxassis ro'yxatdan o'tishi uchun taklif kodi. Bo'sh bo'lsa
  /// ro'yxatdan o'tish yopiq — begona odam akkaunt ocha olmaydi.
  /// Markaz panelida ko'rinmaydi (yakka mutaxassis markazga tegishli emas),
  /// `npm run db:solo-code` bilan qo'yiladi.
  soloInviteCode      String?
  updatedAt           DateTime @updatedAt
}

/// Qabul: markazga birinchi marta kelgan odam (hali mijoz emas).
/// Konsultatsiyadan keyin yo mijozga aylanadi, yo ketadi.
model Intake {
  id           String    @id @default(cuid())
  branchId     String
  specialistId String?
  childName    String
  birthDate    DateTime
  parentName   String
  parentPhone  String
  scheduledAt  DateTime
  /// Konsultatsiya narxi, so'mda
  price        Int       @default(0)
  paidAt       DateTime?
  method       String    @default("CASH")
  /// PLANNED | DONE | NO_SHOW | CANCELLED
  status       String    @default("PLANNED")
  /// PENDING | CONVERTED | THINKING | REFUSED
  result       String    @default("PENDING")
  /// Mijozga aylangan bo'lsa — o'sha mijoz
  clientId     String?   @unique
  note         String?
  createdById  String?
  createdAt    DateTime  @default(now())

  branch     Branch      @relation(fields: [branchId], references: [id])
  specialist Specialist? @relation(fields: [specialistId], references: [id])
  client     Client?     @relation(fields: [clientId], references: [id])

  @@index([branchId, scheduledAt])
  @@index([scheduledAt])
}

model Payment {
  id        String   @id @default(cuid())
  clientId  String
  branchId  String
  packageId String?
  amount    Int
  method    String   @default("CASH")
  paidAt    DateTime @default(now())
  note      String?
  createdAt DateTime @default(now())

  client  Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branch  Branch   @relation(fields: [branchId], references: [id])
  package Package? @relation(fields: [packageId], references: [id])

  @@index([branchId, paidAt])
  @@index([clientId])
}

/// Click orqali onlayn to'lov urinishi. id — Click'ga beriladigan
/// merchant_trans_id (va merchant_prepare_id). status: PENDING | PREPARED | PAID | CANCELLED
model ClickTransaction {
  id           Int      @id @default(autoincrement())
  clientId     String
  branchId     String
  amount       Int
  status       String   @default("PENDING")
  clickTransId String?
  paymentId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([clientId])
}

/// Mutaxassisga ish haqi to'lab berilgani. method: CASH | CARD | TRANSFER
model SalaryPayout {
  id           String    @id @default(cuid())
  specialistId String
  branchId     String
  amount       Int
  method       String    @default("CASH")
  paidAt       DateTime  @default(now())
  /// Qaysi davr uchun to'landi (ixtiyoriy, hisobot uchun)
  periodFrom   DateTime?
  periodTo     DateTime?
  note         String?
  /// Kim to'ladi (admin yoki egasi)
  createdById  String?
  createdAt    DateTime  @default(now())

  specialist Specialist @relation(fields: [specialistId], references: [id], onDelete: Cascade)
  branch     Branch     @relation(fields: [branchId], references: [id])

  @@index([specialistId, paidAt])
  @@index([branchId, paidAt])
}

/// Ota-onaga Telegram orqali yuboriladigan xabar.
/// kind: SESSION_REMINDER | SESSION_DONE | PACKAGE_LOW | DEBT
/// dedupeKey bir xil xabar ikki marta ketmasligini kafolatlaydi.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  clientId  String?
  kind      String
  dedupeKey String    @unique
  text      String
  sentAt    DateTime?
  attempts  Int       @default(0)
  error     String?
  createdAt DateTime  @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([sentAt, attempts])
  @@index([userId, createdAt])
}

/// Seans turi va narxi: "Logoped 45 daq", "Massaj" va h.k. Har xil
/// mashg'ulotning narxi har xil — bitta standart narx yetmaydi.
/// branchId bo'sh — markazniki (hamma filialda); yakka mutaxassisda — uning
/// o'z filiali (markaz turlari unga, uning turlari markazga ko'rinmaydi).
model SessionType {
  id        String   @id @default(cuid())
  branchId  String?
  name      String
  /// Bitta seans narxi, so'mda
  price     Int
  /// Mutaxassisga tegadigan ulush (%). Xizmatga bog'liq: bitta xodim ham
  /// logoped, ham massaj qilsa, har biri uchun o'z foizini oladi.
  salaryPercent Int  @default(40)
  /// O'chirilgan tur ro'yxatdan yo'qoladi, lekin eski seanslarda nomi qoladi
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  branch   Branch?   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  sessions Session[]
  packages Package[]
  clients  ClientService[]

  @@index([branchId])
}

/// Mijozga biriktirilgan xizmatlar. Seans yozilganda xizmat shu ro'yxatdan
/// o'zi olinadi — har safar qo'lda tanlash shart emas.
model ClientService {
  id            String   @id @default(cuid())
  clientId      String
  sessionTypeId String
  createdAt     DateTime @default(now())

  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sessionType SessionType @relation(fields: [sessionTypeId], references: [id], onDelete: Cascade)

  @@unique([clientId, sessionTypeId])
}
